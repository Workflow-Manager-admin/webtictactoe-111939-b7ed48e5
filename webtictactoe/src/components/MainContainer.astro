---
const PRIMARY_COLOR = "#4CAF50";
const SECONDARY_COLOR = "#FFC107";
const ACCENT_COLOR = "#2196F3";
const BOARD_SIZE = 3;

// PUBLIC_INTERFACE
function getInitialBoard() {
  return Array(BOARD_SIZE * BOARD_SIZE).fill("");
}

// PUBLIC_INTERFACE
function checkWinner(board) {
  const lines = [
    // Rows
    [0, 1, 2], [3, 4, 5], [6, 7, 8],
    // Columns
    [0, 3, 6], [1, 4, 7], [2, 5, 8],
    // Diagonals
    [0, 4, 8], [2, 4, 6]
  ];
  for (const [a, b, c] of lines) {
    if (board[a] && board[a] === board[b] && board[a] === board[c]) {
      return board[a];
    }
  }
  return board.every(cell => cell) ? "Draw" : "";
}

// Hooks: Place all interactivity inside a script tag, Astro will hydrate it client-side.
---

<style>
  .ttt-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 80vh;
    justify-content: center;
    background: #fff;
    padding: 2rem;
    border-radius: 1.5rem;
    box-shadow: 0 6px 36px rgba(60,60,60,0.14);
    max-width: 400px;
    margin: 3rem auto;
  }
  .ttt-title {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 2rem;
    color: ${ACCENT_COLOR};
    margin-bottom: 1.2rem;
  }
  .ttt-status {
    font-size: 1.12rem;
    margin-bottom: .8rem;
    color: #222;
    font-weight: 500;
  }
  .ttt-board {
    display: grid;
    grid-template-columns: repeat(${BOARD_SIZE}, 62px);
    grid-template-rows: repeat(${BOARD_SIZE}, 62px);
    gap: 8px;
    margin-bottom: 1.5rem;
  }
  .ttt-cell {
    width: 62px;
    height: 62px;
    background: #fafaf8;
    border: 2px solid ${PRIMARY_COLOR};
    border-radius: 0.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.3rem;
    font-weight: bold;
    color: ${PRIMARY_COLOR};
    cursor: pointer;
    transition: background 0.1s, border 0.2s;
    user-select: none;
  }
  .ttt-cell.X { color: ${PRIMARY_COLOR}; }
  .ttt-cell.O { color: ${SECONDARY_COLOR}; }
  .ttt-cell.disabled {
    pointer-events: none;
    background: #ececec;
    color: #bdbdbd;
  }
  .ttt-result {
    font-size: 1.2rem;
    color: ${PRIMARY_COLOR};
    margin-bottom: 1.2rem;
    min-height: 1.2em;
    font-weight: 600;
    letter-spacing: .02em;
  }
  .ttt-reset-btn {
    background: ${ACCENT_COLOR};
    color: white;
    font-size: 1rem;
    padding: 0.67rem 1.2rem;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    font-weight: 500;
    box-shadow: 0 2px 12px rgba(33,150,243,0.09);
    transition: background .18s;
  }
  .ttt-reset-btn:hover,
  .ttt-reset-btn:focus {
    background: #1764a8;
  }
</style>

<div class="ttt-container" id="ttt-root">
  <div class="ttt-title">
    WebTicTacToe
  </div>
  <div id="status" class="ttt-status">
    Loading...
  </div>
  <div class="ttt-board" id="ttt-board"></div>
  <div class="ttt-result" id="result"></div>
  <button class="ttt-reset-btn" id="reset-btn" type="button">Reset Game</button>
</div>

<script type="module" hydrate="client">
  const BOARD_SIZE = 3;
  const PLAYER_X = "X", PLAYER_O = "O";

  const getInitialBoard = () => Array(BOARD_SIZE * BOARD_SIZE).fill("");

  function checkWinner(board) {
    const lines = [
      [0,1,2], [3,4,5], [6,7,8],
      [0,3,6], [1,4,7], [2,5,8],
      [0,4,8], [2,4,6]
    ];
    for (const [a, b, c] of lines) {
      if (board[a] && board[a] === board[b] && board[a] === board[c]) {
        return board[a];
      }
    }
    return board.every(cell => cell) ? "Draw" : "";
  }

  let board = getInitialBoard();
  let xIsNext = true;
  let winner = "";

  const boardEl = document.getElementById("ttt-board");
  const statusEl = document.getElementById("status");
  const resultEl = document.getElementById("result");
  const resetBtn = document.getElementById("reset-btn");

  function render() {
    // Board
    boardEl.innerHTML = "";
    for (let i = 0; i < board.length; ++i) {
      const cell = document.createElement("button");
      cell.type = "button";
      cell.className = "ttt-cell" + (board[i] ? ` ${board[i]}` : "") + (winner || board[i] ? " disabled" : "");
      cell.textContent = board[i];
      cell.disabled = Boolean(winner || board[i]);
      cell.addEventListener("click", () => handleCellClick(i));
      boardEl.appendChild(cell);
    }
    // Status
    if (!winner) {
      statusEl.textContent = `Current turn: ${xIsNext ? "❌ X" : "⭕ O"}`;
      resultEl.textContent = "";
    } else if(winner === "Draw") {
      statusEl.textContent = '';
      resultEl.textContent = "It's a draw! 🤝";
    } else {
      statusEl.textContent = '';
      resultEl.textContent = `Winner: ${winner === "X" ? "❌ X" : "⭕ O"} 🎉`;
    }
  }

  function handleCellClick(i) {
    if (board[i] || winner) return;
    board[i] = xIsNext ? "X" : "O";
    winner = checkWinner(board);
    xIsNext = !xIsNext;
    render();
  }

  function resetGame() {
    board = getInitialBoard();
    xIsNext = true;
    winner = "";
    render();
  }

  // Event handlers
  resetBtn.addEventListener("click", resetGame);

  // Initial render
  render();
</script>
